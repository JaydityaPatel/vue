GEMINI_API_KEY=replace-with-your-gemini-api-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=30m
DATABASE_URL=sqlite:///./vue.db
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-secret
HARDWARE_TIER=unknown

# Phase 5: explicit device selection; CUDA never silently falls back to CPU.
VOICE_STT_MODEL=small.en
VOICE_STT_DEVICE=cuda
VOICE_STT_COMPUTE_TYPE=int8_float16
# For a machine without working CUDA 12/cuDNN, explicitly use:
# VOICE_STT_DEVICE=cpu
# VOICE_STT_COMPUTE_TYPE=int8
